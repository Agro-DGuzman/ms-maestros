APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlsrv
DB_HOST=sqlserver
DB_PORT=1433
DB_DATABASE=maestros
DB_USERNAME=sa
DB_PASSWORD=Agro.Local.2026
# ODBC Driver 18 cifra siempre. Azure SQL presenta un certificado valido, asi
# que en despliegue esto queda en false; el SQL Server local se firma solo y
# sin confiar en el no conecta.
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=true

# Puerto del host para Keycloak en compose: cambialo si el 8080 ya esta tomado.
KEYCLOAK_PORT=8080
KEYCLOAK_BASE_URL=http://keycloak:8080
KEYCLOAK_REALM=agropartners
KEYCLOAK_CLIENT_ID=ms-maestros
KEYCLOAK_CLIENT_SECRET=

WHATSAPP_DRIVER=log
WHATSAPP_BASE_URL=https://graph.facebook.com/v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_PLANTILLA=desafio_ingreso
WHATSAPP_IDIOMA=es

DESAFIO_MAX_POR_CELULAR_POR_HORA=5
SESION_DIAS=30

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# La cola tiene que ser asincronica: con `sync` el envio del desafio vuelve a
# correr dentro de la peticion y reaparece la fuga de tiempo de /auth/otp.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Back-office de accesos (/admin). El autenticador arranca en `desarrollo`, que
# no pide contrasena y se niega a existir con APP_ENV=production.
BACKOFFICE_AUTENTICADOR=desarrollo
BACKOFFICE_RANGOS_IP=

# Con BACKOFFICE_AUTENTICADOR=contrasena: `correo|hash|Nombre` por persona,
# separados por `;`. Cada linea la genera `php artisan backoffice:hash`.
# Entre comillas: el nombre lleva espacios y sin ellas dotenv no parsea.
BACKOFFICE_OPERADORES=

# Quien dice ser Keycloak: va dentro de cada token como `iss`. Sin definir,
# coincide con KEYCLOAK_BASE_URL, que es el caso de local. En la nube es un
# nombre propio y estable: cambiarlo invalida todo token ya emitido.
KEYCLOAK_ISSUER=

# Keycloak contra Azure (compose.azure.yaml). No versionar valores reales.
AZ_KC_DATABASE=keycloak
AZ_KC_ADMIN_PASSWORD=
AZ_KC_CLIENT_SECRET=
